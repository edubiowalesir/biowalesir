{
  // BioWaleSir.com — Cloudflare Worker (static assets)
  // Push to GitHub main => Cloudflare Workers Builds auto-deploys.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biowalesir",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    // Site files live in the repo root (no build step). .assetsignore keeps
    // repo-only files (README, CLAUDE.md, wrangler.jsonc, src/ ...) from being served.
    "directory": ".",
    "binding": "ASSETS",
    // Clean URLs: /class11 serves class11.html, /chapters/class9/ch2 serves ch2.html.
    // Old /xyz.html URLs redirect to /xyz (Cloudflare Redirect Rule makes it a 301
    // on biowalesir.com; here it is a 307 fallback, e.g. on workers.dev).
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
